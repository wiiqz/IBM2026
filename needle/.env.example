# NEEDLE configuration. Copy to .env and fill in local values.
# Placeholders only. Never commit .env or any real password.

# --- IBM Db2 (admin user: used only for setup, bulk load and the RCAC sweep admin steps) ---
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=VECDB
DB2_USER=db2inst1
DB2_PASSWORD=change_me_db2inst1_password
DB2_SECURITY=false

# --- NEEDLE least-privilege analyst users ---
# One Linux user inside the Db2 container per key: NDL_<ROLE>_PASSWORD -> user ndl_<role>
# (created by scripts/setup_db.sh --with-users or scripts/rcac_users.sh).
# Db2 row and column access control (RCAC) applies to every query they run.
NDL_SENIOR_PASSWORD=change_me_senior
NDL_JUNIOR_PASSWORD=change_me_junior
# Sweep users: they see 10 / 25 / 50 / 75 percent of the rows.
NDL_P10_PASSWORD=change_me_p10
NDL_P25_PASSWORD=change_me_p25
NDL_P50_PASSWORD=change_me_p50
NDL_P75_PASSWORD=change_me_p75

# --- Local models (Ollama) ---
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen3:14b

# --- Data ---
# Folder with the unzipped OSV PyPI export (https://osv-vulnerabilities.storage.googleapis.com/PyPI/all.zip).
OSV_DATA_DIR=./data/osv/PyPI

# --- Optional: GitHub Codespace that hosts Db2 (used by scripts/run_all.ps1 for in-Codespace bulk loads) ---
CODESPACE=

# --- App ---
APP_ENV=development
APP_PORT=8501
